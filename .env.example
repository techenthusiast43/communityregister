# Deployer Private Key for BOT Chain (Do NOT commit with real keys)
PRIVATE_KEY=your_botchain_deployer_private_key_without_0x

# Deployed CommunityRegister Smart Contract Address on BOT Chain Testnet (Chain ID 968)
VITE_COMMUNITY_REGISTER_ADDRESS_TESTNET=

# Deployed CommunityRegister Smart Contract Address on BOT Chain Mainnet (Chain ID 677)
VITE_COMMUNITY_REGISTER_ADDRESS_MAINNET=

# Reown AppKit / WalletConnect Project ID (Optional)
VITE_WALLETCONNECT_PROJECT_ID=

